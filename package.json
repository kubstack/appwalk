{
  "name": "@kubstack/appwalk",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.1",
  "description": "AI-powered CLI that turns browser exploration into verified Playwright regression tests.",
  "keywords": [
    "playwright",
    "e2e-testing",
    "test-generation",
    "ai-agent",
    "browser-automation",
    "regression-testing",
    "cli"
  ],
  "homepage": "https://github.com/kubstack/appwalk#readme",
  "bugs": {
    "url": "https://github.com/kubstack/appwalk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubstack/appwalk.git"
  },
  "license": "MIT",
  "author": "Jakub Mareš (https://github.com/kubzej)",
  "type": "module",
  "bin": {
    "appwalk": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@google/genai": "^2.32.0",
    "dotenv": "^18.0.10",
    "openai": "^7.65.0",
    "playwright": "^1.65.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
